// Contact Sphere — Prisma schema.
//
// Users, sessions and the audit log (Phases 2–3); contacts with their phone
// numbers and email addresses (Phase 4; ADRs 0005, 0007, 0010).
//
// Guarantees Prisma's schema language cannot express — the app role, its
// grants, the append-only audit log, CHECK constraints — live in the
// migration SQL. See ADR 0012.

generator client {
  provider     = "prisma-client"
  // Generated TypeScript is compiled with the API. Git-ignored; regenerate
  // with `npm run prisma:generate`.
  output       = "../apps/api/src/generated/prisma"
  // NestJS compiles to CommonJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// An account. Email is stored lower-case (enforced by a CHECK constraint),
/// so the unique index is effectively case-insensitive.
model User {
  /// UUIDv7: time-ordered, so new rows append to the index instead of
  /// scattering across it, and ids reveal no row count.
  id            String    @id @default(uuid(7)) @db.Uuid
  email         String    @unique @db.VarChar(254)
  /// How the app greets the owner ("Kuria"). Optional; trimmed, never blank.
  displayName   String?   @map("display_name") @db.VarChar(100)
  /// argon2id, in PHC string format (algorithm, parameters and salt are
  /// inside the string). Never the password itself. ADR 0006.
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  /// TOTP secret, ENCRYPTED with the API's TOTP_ENCRYPTION_KEY
  /// (AES-256-GCM, "v1:" prefix). Set while enrolling; kept once enabled.
  /// ADR 0013.
  totpSecret    String?   @map("totp_secret") @db.VarChar(255)
  /// Null = two-factor off (or enrolment not confirmed yet).
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// The last accepted 30-second step; a code can never be used twice.
  totpLastStep  BigInt?   @map("totp_last_step")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs     AuditLog[]
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  mfaChallenges MfaChallenge[]
  contacts      Contact[]
  savedSearches SavedSearch[]

  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256
/// hash is stored here, so a copy of this table cannot be used to sign in.
/// Deleting a row signs that browser out ("sign out everywhere" deletes all
/// of a user's rows). ADR 0006.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// Hex SHA-256 of the session token.
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Refreshed at most every few minutes; drives the idle timeout.
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry, however active the session is.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only record of who did what, and when. The app role may INSERT and
/// SELECT only; UPDATE and DELETE are revoked in the database itself.
///
/// NEVER store contact content here — no names, numbers, emails or notes.
/// Ids and action names only (docs/security/threat-model.md §3). `metadata`
/// is for non-personal facts such as counts or field NAMES that changed.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Null for actions by the system, or after the actor's account is deleted.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// e.g. "contact.merge", "backup.export". Dot-separated, lower-case.
  action      String   @db.VarChar(64)
  entityType  String?  @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One-time recovery codes for when the authenticator is lost. Only a
/// SHA-256 of each code is stored; each works once. ADR 0013.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// The gap between "password correct" and "second factor correct": a
/// short-lived, attempt-limited challenge. Only the token's SHA-256 is
/// stored. ADR 0013.
model MfaChallenge {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  attempts  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

/// A person or organisation in the owner's address book.
///
/// Lifecycle (ADR 0005): active → archived (hidden, kept) and/or trashed
/// (`deleted_at` set; restorable for 30 days) → hard-deleted with its phone
/// numbers and emails. Every query is scoped by `owner_id` (ADR 0004).
model Contact {
  id           String    @id @default(uuid(7)) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  givenName    String?   @map("given_name") @db.VarChar(100)
  familyName   String?   @map("family_name") @db.VarChar(100)
  /// What lists show. Derived from the other fields when left blank, so it
  /// is never empty (CHECK constraint).
  displayName  String    @map("display_name") @db.VarChar(200)
  /// Lower-case, accent-folded display name: case-insensitive A–Z sorting
  /// with a plain index. Maintained by the API (contact-names.ts).
  sortName     String    @map("sort_name") @db.VarChar(200)
  nickname     String?   @db.VarChar(100)
  organization String?   @db.VarChar(200)
  jobTitle     String?   @map("job_title") @db.VarChar(200)
  notes        String?   @db.VarChar(10000)
  birthday     DateTime? @db.Date
  /// Where they are: estate, town, stage ("Kasarani", "Thika Road").
  area         String?   @db.VarChar(100)
  /// How the owner knows them ("church", "Wanjiru's wedding").
  metThrough   String?   @map("met_through") @db.VarChar(200)
  /// What they do or offer ("plumber", "boda boda"). Lower-case, no
  /// repeats, at most 20 (CHECK); normalised by the API.
  tags         String[]  @default([]) @db.VarChar(40)
  /// Folded names, organisation, job, area, met-through, tags and notes, for
  /// word search. Maintained by the API (contact-names.ts); never shown.
  searchText   String    @default("") @map("search_text")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Last time the owner opened this contact in the app (ADR 0007). Never
  /// inferred from call logs.
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  /// Set = in the trash. Hard-deleted 30 days later (ADR 0005).
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phoneNumbers   PhoneNumber[]
  emailAddresses EmailAddress[]
  dismissedAsA   DuplicateDismissal[] @relation("DismissalA")
  dismissedAsB   DuplicateDismissal[] @relation("DismissalB")
  mergesKept     ContactMerge[]       @relation("MergeSurvivor")
  mergesAbsorbed ContactMerge[]       @relation("MergeMerged")

  /// Lets child rows reference (id, owner_id) together, so a phone number
  /// can never belong to one owner while its contact belongs to another.
  @@unique([id, ownerId])
  @@index([ownerId, sortName])
  @@index([ownerId, createdAt])
  @@index([ownerId, lastUsedAt])
  @@index([ownerId, deletedAt])
  @@index([tags], type: Gin)
  @@map("contacts")
}

/// A contact's phone number. Both what the owner typed and, when it parses,
/// the E.164 form are kept (ADR 0010). Position 0 is the primary number.
model PhoneNumber {
  id        String  @id @default(uuid(7)) @db.Uuid
  ownerId   String  @map("owner_id") @db.Uuid
  contactId String  @map("contact_id") @db.Uuid
  /// e.g. "mobile", "work". Free text, optional.
  label     String? @db.VarChar(40)
  /// Exactly as entered or imported. Never rewritten.
  raw       String  @db.VarChar(64)
  /// Null when the number could not be parsed; such numbers are kept, not
  /// rejected (old SIM exports contain oddities).
  e164      String? @db.VarChar(16)
  /// The digits of `raw`, for "0712"-style partial search.
  digits    String  @db.VarChar(64)
  position  Int     @db.SmallInt

  contact Contact @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([contactId, position])
  @@index([ownerId, e164])
  @@map("phone_numbers")
}

/// A contact's email address. Position 0 is the primary address.
model EmailAddress {
  id        String  @id @default(uuid(7)) @db.Uuid
  ownerId   String  @map("owner_id") @db.Uuid
  contactId String  @map("contact_id") @db.Uuid
  label     String? @db.VarChar(40)
  /// Stored lower-case (CHECK constraint), so matching is case-insensitive.
  address   String  @db.VarChar(254)
  position  Int     @db.SmallInt

  contact Contact @relation(fields: [contactId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([contactId, position])
  @@index([ownerId, address])
  @@map("email_addresses")
}

/// "These two are not the same person": the pair is never suggested again.
/// Stored with the smaller id first (CHECK), so each pair exists once.
model DuplicateDismissal {
  id         String   @id @default(uuid(7)) @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  contactAId String   @map("contact_a_id") @db.Uuid
  contactBId String   @map("contact_b_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contactA Contact @relation("DismissalA", fields: [contactAId, ownerId], references: [id, ownerId], onDelete: Cascade)
  contactB Contact @relation("DismissalB", fields: [contactBId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([ownerId, contactAId, contactBId])
  @@map("duplicate_dismissals")
}

/// One merge, kept so it can be undone (ADR 0005): the survivor's state
/// before the merge is stored; the merged-away contact waits in the trash.
/// When either contact is deleted for good, the record goes with it — and
/// so does the possibility of undoing.
model ContactMerge {
  id             String    @id @default(uuid(7)) @db.Uuid
  ownerId        String    @map("owner_id") @db.Uuid
  survivorId     String    @map("survivor_id") @db.Uuid
  mergedId       String    @map("merged_id") @db.Uuid
  /// The survivor exactly as it was before the merge (fields, numbers,
  /// emails). The owner's own data; deleted with the contacts.
  survivorBefore Json      @map("survivor_before")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  undoneAt       DateTime? @map("undone_at") @db.Timestamptz(3)

  survivor Contact @relation("MergeSurvivor", fields: [survivorId, ownerId], references: [id, ownerId], onDelete: Cascade)
  merged   Contact @relation("MergeMerged", fields: [mergedId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([ownerId, survivorId])
  @@index([ownerId, mergedId])
  @@map("contact_merges")
}

/// A search the owner keeps for one tap: words, a tag, or both
/// ("plumber" in "Kasarani"). At least one of them is set (CHECK).
model SavedSearch {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  /// What the chip says. Unique per owner.
  name      String   @db.VarChar(60)
  /// The search words, as typed ("" for none).
  query     String   @default("") @db.VarChar(100)
  /// One tag, lower-case, or null.
  tag       String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@map("saved_searches")
}
