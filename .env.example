# Contact Sphere — environment variables.
#
# Copy the section you need into the file named in its heading. Those files
# are git-ignored. NEVER put real values in this file.

# ---------------------------------------------------------------------------
# API — apps/api/.env (optional locally; defaults are safe for development)
# ---------------------------------------------------------------------------

# development | test | production. Render sets production.
NODE_ENV=development

# Port to listen on. Render supplies its own.
PORT=3001

# Exact web origins allowed to call the API, comma-separated. Required in
# production (https only). Never "*".
WEB_ORIGIN=http://localhost:3000

# Reverse proxies in front of the API that may set X-Forwarded-For.
# 0 locally, 1 on Render.
TRUST_PROXY_HOPS=0

# Runtime database connection: the least-privilege APP role
# (contact_sphere_app), never the owner. Deployed: Neon POOLED host (contains
# "-pooler") and sslmode=verify-full. Locally: see README "Database".
DATABASE_URL=postgresql://contact_sphere_app:CHANGE_ME@localhost:5432/contact_sphere_dev

# Shared secret the web server sends with every API call (ADR 0006). Must be
# identical in apps/web/.env.local. At least 32 chars: openssl rand -hex 32
API_SHARED_SECRET=CHANGE_ME_to_a_long_random_value_0123456789

# Encrypts two-factor (TOTP) secrets at rest (ADR 0013). 64 hex chars:
# openssl rand -hex 32. Losing it disables everyone's authenticator codes.
TOTP_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_0000000000000000000000000000000000000000

# Optional. Enables /setup (creating the first account) while no account
# exists. At least 32 chars. Remove once your account is created.
SETUP_TOKEN=

# Optional (Phase 11). Morning reminders on the phone (Web Push). All three
# or none; generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional (Phase 11). Paid group texts through an SMS aggregator. Off when
# unset. "partner" = Celcom/Advanta/TextSMS partnerID API; "log" = records
# only (tests, local). SMS_MONTHLY_LIMIT is SMS parts per owner per month
# (0 = off). docs/product/messaging-costs.md
SMS_PROVIDER=
# SMS_API_URL=https://isms.celcomafrica.com/api/services/
# SMS_API_KEY=
# SMS_PARTNER_ID=
# SMS_SENDER_ID=
# SMS_MONTHLY_LIMIT=0
# SMS_PRICE_KES=0.35

# ---------------------------------------------------------------------------
# Prisma CLI (migrations) — set in your shell for the command, not in a file
# ---------------------------------------------------------------------------

# Migrations connect as the database OWNER on a direct (non-pooled) host.
# Deliberately not read from any .env file (see prisma.config.ts).
# DIRECT_URL=postgresql://OWNER:PASSWORD@HOST/DB?sslmode=verify-full

# ---------------------------------------------------------------------------
# Web — apps/web/.env.local
# ---------------------------------------------------------------------------

# Where the Next.js SERVER reaches the API. Server-side only: deliberately
# not NEXT_PUBLIC_, so it is never shipped to browsers.
API_URL=http://localhost:3001

# The same value as the API's API_SHARED_SECRET. Server-side only.
API_SHARED_SECRET=CHANGE_ME_to_a_long_random_value_0123456789

# Optional (Phase 11). Vercel Cron sends it as "Bearer ..." to /cron/digest
# (morning reminders). At least 32 chars. Unset = the route answers 404.
CRON_SECRET=
