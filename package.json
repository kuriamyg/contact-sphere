{
  "name": "contact-sphere",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first private contact management platform",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:app-role": "node scripts/create-app-login-role.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:db && npm run test:e2e && npm run build",
    "test:db": "npm run test:db --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
